{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile and Run",
      "type": "shell",
      "command": "g++ -std=c++17 \"${file}\" -o \"${fileBasenameNoExtension}.exe\" && ./${fileBasenameNoExtension}.exe < input.txt > output.txt 2>&1",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
